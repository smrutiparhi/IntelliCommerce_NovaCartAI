# Copy to .env (gitignored) and fill in real values. Never commit real secrets.

# --- JWT (RS256) --- generate your own with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private-key.pem
#   openssl rsa -pubout -in keys/jwt-private-key.pem -out keys/jwt-public-key.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public-key.pem

# --- MongoDB (local dev — Atlas connection string for deployment, see docs/DATABASE.md) ---
AUTH_DB_URI=mongodb://localhost:27017/auth_db

# --- Redis (local dev) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Razorpay (payment-service) ---
# Set real test credentials before using the hosted checkout. Keep simulation true for local demo mode.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ALLOW_SIMULATION=false

# --- OpenAI (AI assistant RAG) ---
# Leave OPENAI_API_KEY empty to use deterministic local embeddings and extractive answers.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Minimum retrieval score before Nova AI answers; below this it returns no-answer.
RAG_NO_ANSWER_SCORE=0.24

# --- Gemini AI Studio (takes precedence over OpenAI when configured) ---
GEMINI_API_KEY=
GEMINI_RESPONSE_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Password reset email ---
# Local Compose defaults to Mailpit at http://localhost:8025.
# Configure a real SMTP service and public frontend URL before deployment.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=no-reply@novacart.local
APP_FRONTEND_URL=http://localhost:3000
